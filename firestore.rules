rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Provider profile and chargers
    match /providers/{providerId} {
      allow read, write: if request.auth != null && request.auth.uid == providerId;
      match /chargers/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == providerId;
      }
    }

    // User profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bookings: Providers can read/update bookings assigned to them, users can read their own
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (resource.data.providerId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.providerId != request.auth.uid
        && exists(/databases/$(database)/documents/public_chargers/$(request.resource.data.chargerId))
        && get(/databases/$(database)/documents/public_chargers/$(request.resource.data.chargerId)).data.status == 'active'
        && get(/databases/$(database)/documents/public_chargers/$(request.resource.data.chargerId)).data.providerId == request.resource.data.providerId;
      allow update: if request.auth != null && (resource.data.providerId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Reviews: readable and writable by participating providers and drivers
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Public chargers read access for driver exploration
    match /public_chargers/{chargerId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.providerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.providerId == request.auth.uid;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
