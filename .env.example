# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_MAP_TILES_API_KEY: Optional API key for live vector map tiles.
# When omitted, ChargeShare renders an interactive SVG neighbourhood coordinate map.
VITE_MAP_TILES_API_KEY=""

# Firebase Web SDK configuration.
# Firebase Console → Project settings → General → Your apps → Web app config.
# Required for Google and Email/Password authentication.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Server-only admin accounts. Keep this variable free of the VITE_ prefix.
# Use long, unique passwords. Google sign-in is also accepted for listed emails.
ADMIN_USERS='[{"email":"admin@example.com","password":"replace-with-a-long-unique-password"}]'
ADMIN_SESSION_SECRET="generate-a-random-value-at-least-32-characters-long-for-production"

# Firebase Admin credentials for the backend API. Choose one:
# 1. Set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path outside this repo.
# 2. Set FIREBASE_SERVICE_ACCOUNT_JSON to the service-account JSON contents.
# On Cloud Run, use the attached service identity instead of downloading a key.
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""

# Optional server-only APILayer Positionstack key for forward and reverse geocoding.
# If empty, reverse lookups use OpenStreetMap Nominatim and area search uses its existing fallback.
APILAYER_POSITIONSTACK_ACCESS_KEY=""

# Provider charger photos are stored in Firebase Storage using the configured
# VITE_FIREBASE_STORAGE_BUCKET. Rules are in storage.rules.
